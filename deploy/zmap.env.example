# Copy to /etc/zmap.env (chmod 640, root:zmap). No secrets are needed.
# Page title. Only a fallback: PublicName from <PZ_DATA_PATH>/Server/<SERVER_INI>.ini wins when set.
SERVER_NAME=My Zomboid Server
SERVER_INI=pzserver
# Zomboid user data folder (contains Lua/ and server-console.txt)
PZ_DATA_PATH=/srv/zomboid-server/Zomboid
REFRESH_SECONDS=5
# Keep on loopback; expose with cloudflared / a reverse proxy.
BIND_ADDR=127.0.0.1
PORT=8780
TILE_CACHE_DIR=/var/cache/zmap/tiles
TILE_CACHE_MAX_MB=1024
